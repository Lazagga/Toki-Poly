  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.95, g: 0.94, b: 0.88, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: c74e38b9615f2494b82645a982bdaaa9, type: 3}
    m_FontSize: 24
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.05
  m_Text: "<color=#F3C969><b>\uC8FC\uC0AC\uC704</b></color>\n\uC8FC\uC0AC\uC704\uB97C
    \uC120\uD0DD\uD558\uACE0 \uAD74\uB824 \uB208\uC758 \uD569\uB9CC\uD07C \uC774\uB3D9\uD569\uB2C8\uB2E4.\n\n<color=#F3C969><b>\uAC74\uC124\uACFC
    \uAC15\uD654</b></color>\n\uB3C4\uCC29\uD55C \uD0C0\uC77C\uC5D0\uC11C \uD0C0\uC6CC\uB97C
    \uAC74\uC124 \uB610\uB294 \uC5C5\uADF8\uB808\uC774\uB4DC\uD569\uB2C8\uB2E4. \uC644\uC8FC\uC2DC
    \uBAA8\uB4E0 \uD0C0\uC6CC\uC758 \uACF5\uACA9\uB825\uC774 \uAC15\uD654\uB429\uB2C8\uB2E4.\n\n<color=#F3C969><b>\uBCF4\uB108\uC2A4
    \uD0C0\uC77C</b></color>\n\uBCF4\uB108\uC2A4 \uD0C0\uC77C\uC740 \uCC98\uC74C\uBD80\uD130
    2\uB2E8\uACC4 \uAC74\uBB3C\uC744 \uC9C0\uC744 \uC218 \uC788\uACE0, 3\uB2E8\uACC4
    \uAC15\uD654\uB97C \uD55C\uBC88 \uB354 \uACE0\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n<color=#F3C969><b>\uC815\uBCF4\uC640
    \uBC30\uC18D</b></color>\n\uD0C0\uC77C\uC744 \uB20C\uB7EC \uC815\uBCF4\uB97C
    \uD655\uC778\uD558\uACE0 \uC6B0\uCE21 \uD558\uB2E8\uC5D0\uC11C \uBC30\uC18D\uC744
    \uC804\uD658\uD569\uB2C8\uB2E4.\n\n<color=#F3C969><b>\uC2B9\uD328</b></color>\n\uBCF4\uC2A4
    \uB4F1\uC7A5 \uD6C4 \uBAA8\uB4E0 \uC801 \uD3EC\uD68D \uC2DC \uC2B9\uB9AC\uD569\uB2C8\uB2E4.
    \uBAAC\uC2A4\uD130 5\uB9C8\uB9AC\uAC00 \uC644\uC8FC\uD558\uAC8C \uB9CC\uB4E4\uAC70\uB098
    \uAE4C\uB9C8\uADC0\uAC00 \uC644\uC8FC\uD558\uBA74 \uD328\uBC30\uD569\uB2C8\uB2E4."
